<Window x:Class="BreatheCalc.FourDispense.StepInputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:util="clr-namespace:BreatheCalc.FourDispense.Util"
        xmlns:fourDispense="clr-namespace:BreatheCalc.FourDispense"
        Title="Sucky TECC File Import Info"
        SizeToContent="WidthAndHeight"
        WindowStyle="ToolWindow"
        WindowStartupLocation="CenterOwner"
        Loaded="StepInputWindow_OnLoaded"
        >
<Window.Resources>
        <Style TargetType="CheckBox">
            <Setter Property="VerticalAlignment" Value="Center"></Setter>
            <Setter Property="HorizontalAlignment" Value="Center"></Setter>
        </Style>

        <Style TargetType="Label">
            <Setter Property="VerticalAlignment" Value="Center"></Setter>
        </Style>

        <Style TargetType="Button">
            <Setter Property="VerticalAlignment" Value="Center"></Setter>
            <Setter Property="Margin" Value="3"></Setter>
        </Style>
    
        <Style TargetType="TextBox">
            <Setter Property="VerticalAlignment" Value="Center"></Setter>
        </Style>
</Window.Resources>
    <Grid Margin="6">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"></ColumnDefinition>
            <ColumnDefinition Width="Auto"></ColumnDefinition>
            <ColumnDefinition Width="Auto"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="12"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
        </Grid.RowDefinitions>

        <Label Grid.Row="0" Grid.Column="0">Baseline Pts</Label>
        <TextBox Grid.Row="0" Grid.Column="1" MinWidth="40" Text="{util:SettingBinding Baseline, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextChanged="Points_OnTextChanged"></TextBox>

        <Label Grid.Row="1" Grid.Column="0">Benzamil Pts</Label>
        <TextBox Grid.Row="1" Grid.Column="1" MinWidth="40" Text="{util:SettingBinding Benzamil, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextChanged="Points_OnTextChanged"></TextBox>

        <Label Grid.Row="2" Grid.Column="0">Forksolin Pts</Label>
        <TextBox Grid.Row="2" Grid.Column="1" MinWidth="40" Text="{util:SettingBinding Forksolin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextChanged="Points_OnTextChanged"></TextBox>
        <Label Grid.Row="2" Grid.Column="2">(Alone)</Label>

        <Label Grid.Row="3" Grid.Column="0">Potentiator Pts</Label>
        <TextBox Grid.Row="3" Grid.Column="1" MinWidth="40" Text="{util:SettingBinding Potentiator, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextChanged="Points_OnTextChanged"></TextBox>
        <Label Grid.Row="3" Grid.Column="2">(or Forksolin + Potentiator)</Label>

        <Label Grid.Row="4" Grid.Column="0">Inhibitor Pts</Label>
        <TextBox Grid.Row="4" Grid.Column="1" MinWidth="40" Text="{util:SettingBinding Bumetinide, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextChanged="Points_OnTextChanged"></TextBox>
        
        <Label Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3" MinWidth="40" Name="maxPts" >fffffffffffffffffffffffffffffffffffffffffffffff</Label>

        <Label Grid.Row="6" Grid.Column="0">Row Wise</Label>
        <CheckBox Grid.Row="6" Grid.Column="1" Margin="-3,0,0,0" MinWidth="40" VerticalAlignment="Center" HorizontalAlignment="Center" IsChecked="{util:SettingBinding RowWise, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"></CheckBox>
        <Label Grid.Row="6" Grid.Column="2">(The New Head)</Label>
        
        <StackPanel Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Center">
            <CheckBox Style="{x:Null}" Padding="1" VerticalAlignment="Center" IsChecked="{util:SettingBinding SparcsRocks, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                <CheckBox.Content>
                    <Label Padding="3,0,0,3">I acknowledge that SPaRCS rocks!</Label>
                </CheckBox.Content>    
            </CheckBox>
            
            <Button Click="Done" IsEnabled="{util:SettingBinding SparcsRocks, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}">Done</Button>
            <Button Click="Cancel">Cancel</Button>
        </StackPanel>
    </Grid>
</Window>

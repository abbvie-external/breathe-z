<Window x:Class="BreatheZ.Ui.View.StepInputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:util1="clr-namespace:BreatheZ.Ui.Util"
        Title="Sucky TECC File Import Info"
        SizeToContent="WidthAndHeight"
        WindowStyle="ToolWindow"
        WindowStartupLocation="CenterOwner"
        >
    <Window.Resources>
        <Style TargetType="CheckBox">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>

        <Style TargetType="Label">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="3" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>
    <Grid Margin="6">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Label Grid.Row="0" Grid.Column="0">Baseline Pts</Label>
        <TextBox Grid.Row="0" Grid.Column="1" MinWidth="40" Text="{util1:SettingBinding Baseline, Mode=TwoWay}" />

        <Label Grid.Row="1" Grid.Column="0">Benzamil Pts</Label>
        <TextBox Grid.Row="1" Grid.Column="1" MinWidth="40" Text="{util1:SettingBinding Benzamil, Mode=TwoWay}" />

        <Label Grid.Row="2" Grid.Column="0">Forskolin Pts</Label>
        <TextBox Grid.Row="2" Grid.Column="1" MinWidth="40" Text="{util1:SettingBinding Forksolin, Mode=TwoWay}" />
        <Label Grid.Row="2" Grid.Column="2">(Alone)</Label>

        <Label Grid.Row="3" Grid.Column="0">Potentiator Pts</Label>
        <TextBox Grid.Row="3" Grid.Column="1" MinWidth="40" Text="{util1:SettingBinding Potentiator, Mode=TwoWay}" />
        <Label Grid.Row="3" Grid.Column="2">(or Forskolin + Potentiator)</Label>

        <Label Grid.Row="4" Grid.Column="0">Inhibitor Pts</Label>
        <TextBox Grid.Row="4" Grid.Column="1" MinWidth="40" Text="{util1:SettingBinding Bumetinide, Mode=TwoWay}" />

        <Label Grid.Row="5" Grid.Column="0">UTP Pts</Label>
        <TextBox Grid.Row="5" Grid.Column="1" MinWidth="40" Text="{util1:SettingBinding Utp, Mode=TwoWay}" />

        <Label Grid.Row="6" Grid.Column="0">Measurement Interval</Label>
        <TextBox Grid.Row="6" Grid.Column="1" MinWidth="40" Text="{util1:SettingBinding TimeCheckPointInSeconds, Mode=TwoWay}" />

        <CheckBox Grid.Row="7" Grid.Column="0" HorizontalAlignment="Left" IsChecked="{util1:SettingBinding Use2Plates, Mode=TwoWay}" Margin="3,3,3,3" >Use 2 Plates</CheckBox>

        <StackPanel Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Click="Done" IsEnabled="{util1:SettingBinding SparcsRocks, Mode=OneWay}">Done</Button>
            <Button Click="Cancel">Cancel</Button>
        </StackPanel>
    </Grid>
</Window>
